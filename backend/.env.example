# Market Master backend — local development template.
# Copy to .env and fill in real values. NEVER commit real credentials.
# SERVICE_ROLE key is backend-only. Never use it in React / VITE_* vars.

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service_role key (backend-only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Flask session secret (set a strong random value in production)
SECRET_KEY=change-me-in-production

# JWT signing secret for existing auth (min 32 bytes in production)
JWT_SECRET=change-me-in-production-32bytes-min

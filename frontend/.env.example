# Market Master Frontend — Environment Variables Template
# Copy to frontend/apps/web/.env.local or set in your hosting platform (Vercel, Netlify, Cloudflare).

# Backend API Base URL
# - In Vercel Monorepo deployment (same origin with /api rewrites): Leave empty or unset ("")
# - In Separate Deployment (e.g. Frontend on Vercel, Backend on Render/Railway):
#   Set to your live backend domain, e.g.: https://your-backend-api.onrender.com
VITE_API_BASE_URL=
